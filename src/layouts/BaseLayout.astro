---
import '../styles/global.css';
import data from '../data/knowledge.json';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'pikk-vaade' | 'teemad' | 'riigikogu' | 'analuusid';
}

const {
  title,
  description = 'Eesti Ehitusettevõtjate Liidu (EEEL) seisukohad ja „Ehituse pikk vaade 2035“ seire.',
  activeNav = 'home',
} = Astro.props;

const base = data.basePath || '/huvikaitse';
---
<!DOCTYPE html>
<html lang="et">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Avaleht' ? 'EEELi seisukohad' : `${title} · EEELi seisukohad`}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="page-wrap header-inner">
        <a href={`${base}/`} class="brand-link">EEELi seisukohad</a>
        <nav class="main-nav" aria-label="Peamenüü">
          <a href={`${base}/`} class:list={['nav-link', { active: activeNav === 'home' }]}>Avaleht</a>
          <a href={`${base}/pikk-vaade-2035/`} class:list={['nav-link', { active: activeNav === 'pikk-vaade' }]}>Pikk vaade 2035</a>
          <a href={`${base}/teemad/`} class:list={['nav-link', { active: activeNav === 'teemad' }]}>Teemad ({data.counts.topics})</a>
          {data.analyses.length > 0 && (
            <a href={`${base}/analuusid/`} class:list={['nav-link', { active: activeNav === 'analuusid' }]}>Analüüsid</a>
          )}
        </nav>
      </div>
    </header>

    <main>
      <div class="page-wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="page-wrap footer-inner">
        <div>
          Eesti Ehitusettevõtjate Liit (EEEL) ·
          <a href="https://eeel.ee" target="_blank" rel="noopener">eeel.ee</a> ·
          <a href="mailto:eeel@eeel.ee">eeel@eeel.ee</a>
        </div>
        <div>
          Sünkroonitud: <span class="mono-num">{data.syncedAtDisplay}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
