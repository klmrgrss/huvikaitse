---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/knowledge.json';
import { renderInline, renderMarkdown } from '../lib/markdown';

const base = data.basePath || '/huvikaitse';
const pv = data.pikkVaade || {};
const steps = pv.steps || [];
const actions = pv.actions || [];
const kpis = pv.kpis || [];
const kpiCards = pv.kpiCards || [];
const extraSections = pv.extraSections || [];

const actionHeaders =
  pv.actionHeaders && pv.actionHeaders.length >= 6
    ? pv.actionHeaders
    : ['Nr', 'Tegevus ja põhiväljund', 'Vastutaja', 'KLIM 2026', 'EEEL-i hinnang ja selgitus', 'Seotud teema', 'Märkused'];
const extraActionHeaders = actionHeaders.slice(7);

const kpiHeaders =
  pv.kpiHeaders && pv.kpiHeaders.length >= 2
    ? pv.kpiHeaders
    : ['#', 'Mõõdik ja ühik', 'Samm', 'Baastase', '2030 / 2035 siht ja võrdlus', 'Andmeallikas', 'Sagedus'];

function formatAssessment(md: string): string {
  const html = renderInline(md);
  return html
    .replace(/🟢\/🟡\s*/g, '<span class="dot dot-warn" title="Osaline edasiminek">◐</span>')
    .replace(/🟢\s*/g, '<span class="dot dot-ok" title="Sisuline edasiminek">●</span>')
    .replace(/🟡\s*/g, '<span class="dot dot-warn" title="Osaline / ettevalmistamisel">●</span>')
    .replace(/🔴\s*/g, '<span class="dot dot-alert" title="Vajab edasiviimist">●</span>')
    .replace(/⛔\s*/g, '<span class="dot dot-conflict" title="Vastuolu kokkuleppega">◆</span>');
}

function kpiCellClass(header: string, idx: number): string {
  const h = header.toLowerCase();
  if (idx === 0 || h === '#') return 'num-col';
  if (h.includes('samm') || h.includes('allikas') || h.includes('sagedus')) return 'status-col';
  return '';
}
---

<BaseLayout title={`${pv.title || 'Ehituse pikk vaade 2035'} — seiretöölaud`} activeNav="pikk-vaade">
  <div class="breadcrumb">
    <a href={`${base}/`}>Avaleht</a> <span>/</span> <span>{pv.title || 'Ehituse pikk vaade 2035'}</span>
  </div>

  <!-- Asymmetric intro + Tufte word-sized KPI margin (100% driven by Obsidian Veeb/) -->
  <section class="tufte-grid">
    <div class="tufte-main">
      <p class="kicker">{pv.kicker || 'Avalik seiretöölaud · 09.06.2021 ühiskondlik kokkulepe'}</p>
      <h1>{pv.title || 'Ehituse pikk vaade 2035'}</h1>
      <p class="lead" set:html={renderInline(pv.lead || '')} />
      <div class="text-actions">
        <a href={`${base}/teemad/ehituse-pikk-vaade-2035-kokkulepe-ja-seire/`} class="action-link">
          Loe kokkuleppe põhimõtteid →
        </a>
        <a href="#tegevused" class="action-link-secondary">Tegevuste ülevaade ({actions.length}) ↓</a>
        <a href="#moodikud" class="action-link-secondary">Seiremõõdikud ({kpis.length}) ↓</a>
        {extraSections.map((sec) => (
          <a href={`#${sec.id}`} class="action-link-secondary">{sec.heading} ↓</a>
        ))}
      </div>
    </div>

    <aside class="tufte-margin" aria-label="Kokkuleppe võtmenäitajad">
      <div class="margin-block">
        <p class="margin-heading">Kokkuleppe võtmenäitajad</p>
        <div class="kpi-list">
          {kpiCards.map((c) => (
            <div class="kpi-row">
              <div class="kpi-head">
                <span class:list={['kpi-figure', c.colorClass]}>
                  {c.value}
                  {c.barPct !== null && c.barPct !== undefined && (
                    <svg class="sparkbar" width="52" height="8" viewBox="0 0 52 8" aria-hidden="true">
                      <rect x="0" y="1" width="52" height="6" fill="#eceae0" />
                      <rect
                        x="0"
                        y="1"
                        width={Math.max(3, Math.round((c.barPct / 100) * 52))}
                        height="6"
                        fill={c.barColor || '#555555'}
                      />
                    </svg>
                  )}
                </span>
                <span class="meta-label">{c.label}</span>
              </div>
              {c.caption && <div class="kpi-caption" set:html={renderInline(c.caption)} />}
            </div>
          ))}
        </div>
      </div>
    </aside>
  </section>

  <hr class="rule" />

  <!-- Full-width High Data-Ink 7-Step Comparison Figure -->
  <section aria-labelledby="steps-heading">
    <div class="figure-head">
      <h2 id="steps-heading">{pv.stepsHeading || '7 suure sammu täitmine'}</h2>
      {pv.stepsRightLabel && <span class="meta-label">{pv.stepsRightLabel}</span>}
    </div>

    <div class="figure-legend">
      <span><span class="dot dot-ok">●</span>Valmis / sisuline edasiminek</span>
      <span><span class="dot dot-mid">●</span>KLIM: töös (~50%)</span>
      <span><span class="dot dot-warn">●</span>Osaline / ettevalmistamisel</span>
      <span><span class="dot dot-alert">●</span>Vajab edasiviimist / vastuolu</span>
    </div>

    {steps.map((s) => {
      const tot = Math.max(s.total || 1, 1);
      const k = s.klimCounts || { valmis: 0, toos: 0, alustatud: 0, seisab: 0 };
      const e = s.eeelCounts || { edasiminek: 0, osaline: 0, kriitiline: 0 };
      const isDominant = s.num === 2 || s.code === 'Samm 2' || s.code === 'E2';
      return (
        <div class="step-row">
          <div class="step-title">
            <strong>{s.code}.</strong> {s.name}
            <span class="step-count">({s.total})</span>
          </div>

          <div class="step-bars">
            <span class="bar-lbl">{pv.klimBarLabel || 'KLIM 2026'}</span>
            <div class="bar-track" aria-label={`KLIM: ${k.valmis} valmis, ${k.toos} töös, ${k.alustatud} alustatud, ${k.seisab} seisab`}>
              {k.valmis > 0 && <div class="seg seg-ok" style={`width:${(k.valmis / tot) * 100}%`} />}
              {k.toos > 0 && <div class="seg seg-mid" style={`width:${(k.toos / tot) * 100}%`} />}
              {k.alustatud > 0 && <div class="seg seg-warn" style={`width:${(k.alustatud / tot) * 100}%`} />}
              {k.seisab > 0 && <div class="seg seg-alert" style={`width:${(k.seisab / tot) * 100}%`} />}
            </div>
            <span class="bar-num">{k.valmis}/{k.toos}/{k.alustatud}/{k.seisab}</span>

            <span class="bar-lbl">{pv.eeelBarLabel || 'EEEL hinnang'}</span>
            <div class="bar-track" aria-label={`EEEL: ${e.edasiminek} edasiminek, ${e.osaline} osaline, ${e.kriitiline} vajab edasiviimist`}>
              {e.edasiminek > 0 && <div class="seg seg-ok" style={`width:${(e.edasiminek / tot) * 100}%`} />}
              {e.osaline > 0 && <div class="seg seg-warn" style={`width:${(e.osaline / tot) * 100}%`} />}
              {e.kriitiline > 0 && <div class="seg seg-alert" style={`width:${(e.kriitiline / tot) * 100}%`} />}
            </div>
            <span class="bar-num">{e.edasiminek}/{e.osaline}/{e.kriitiline}</span>
          </div>

          <div class:list={['step-gdp', { 'is-dominant': isDominant }]}>
            +{s.gdpMln} M€/a
            <span class="step-gdp-share">{s.gdpShare} SKP mõjust</span>
          </div>
        </div>
      );
    })}
  </section>

  <!-- Full-width Booktabs Actions Matrix -->
  <section id="tegevused" style="margin-top: 3rem;">
    <h2 style="margin-top: 0; margin-bottom: 0.35rem;">{pv.actionsHeading || 'Tegevuste täitmise ülevaade'}</h2>
    {pv.actionsIntro && (
      <p style="color: var(--ink-secondary); margin: 0 0 1rem; font-size: 0.98rem;" set:html={renderInline(pv.actionsIntro)} />
    )}

    <div class="control-bar-inline">
      <div class="toggle-group" id="step-toggles" aria-label="Filtreeri sammu järgi">
        <button class="toggle-btn active" data-step="all">Kõik sammud</button>
        {steps.map((s) => (
          <button class="toggle-btn" data-step={s.code}>{s.code}</button>
        ))}
      </div>

      <div class="toggle-group" id="status-toggles" aria-label="Filtreeri seisu järgi">
        <button class="toggle-btn active" data-status="all">Kõik seisud</button>
        <button class="toggle-btn" data-status="kriitiline"><span class="dot dot-alert">●</span>Vajab edasiviimist</button>
        <button class="toggle-btn" data-status="vastassuunaline"><span class="dot dot-conflict">◆</span>Vastuolu</button>
        <button class="toggle-btn" data-status="osaline"><span class="dot dot-warn">●</span>Osaline</button>
        <button class="toggle-btn" data-status="edasiminek"><span class="dot dot-ok">●</span>Edasiminek</button>
      </div>
    </div>

    <div class="table-wrap">
      <table id="actions-table">
        <thead>
          <tr>
            <th style="width:6%">{actionHeaders[0] || 'Nr'}</th>
            <th style="width:22%">{actionHeaders[1] || 'Tegevus ja põhiväljund'}</th>
            <th style="width:10%">{actionHeaders[2] || 'Vastutaja'}</th>
            <th style="width:11%">{actionHeaders[3] || 'KLIM 2026'}</th>
            <th style="width:30%">{actionHeaders[4] || 'EEEL-i hinnang ja selgitus'}</th>
            <th style="width:13%">{actionHeaders[5] || 'Seotud teema'}</th>
            <th style="width:8%">{actionHeaders[6] || 'Märkused'}</th>
            {extraActionHeaders.map((h) => (
              <th>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {actions.map((a) => (
            <tr data-step={a.goalCode} data-status={a.eeelCat}>
              <td class="num-col" style="text-align:left;">{a.nr}</td>
              <td set:html={renderInline(a.title)} />
              <td class="status-col" style="white-space:normal;">{a.owner}</td>
              <td class="status-col">{a.klimStatus}</td>
              <td set:html={formatAssessment(a.eeelAssessment)} />
              <td set:html={renderInline(a.related)} />
              <td set:html={renderInline(a.note || '—')} />
              {extraActionHeaders.map((_, idx) => (
                <td set:html={renderInline((a.extraCells && a.extraCells[idx]) || '—')} />
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Full-width Dynamic-Column KPI Monitoring Registry -->
  <section id="moodikud" style="margin-top: 3rem;">
    <h2 style="margin-top: 0; margin-bottom: 0.35rem;">
      {pv.kpisHeading || 'Aastate lõikes jälgitavad seiremõõdikud'} ({kpis.length})
    </h2>
    {pv.kpisIntro && (
      <p style="color: var(--ink-secondary); margin: 0 0 1rem; font-size: 0.98rem;" set:html={renderInline(pv.kpisIntro)} />
    )}

    <div class="control-bar-inline">
      <input
        id="kpi-search"
        type="search"
        class="tufte-input"
        style="max-width: 380px;"
        placeholder="Filtreeri mõõdikuid märksõna või allika järgi (nt Eurostat, RHR, EMTA, Soome)…"
        aria-label="Otsi seiremõõdikuid"
      />
      <div class="toggle-group" id="kpi-step-toggles" aria-label="Filtreeri mõõdikuid sammu järgi">
        <button class="toggle-btn active" data-kpi-step="all">Kõik</button>
        {steps.map((s) => (
          <button class="toggle-btn" data-kpi-step={s.code}>{s.code}</button>
        ))}
      </div>
    </div>

    <div class="table-wrap">
      <table id="kpi-table">
        <thead>
          <tr>
            {kpiHeaders.map((h, idx) => (
              <th style={idx === 0 ? 'width:4%; text-align:right;' : undefined}>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {kpis.map((k) => {
            const cells = k.cells || [k.id, k.name, k.step, k.baseline, k.target, k.source, k.frequency];
            return (
              <tr data-kpi-step={k.stepCode} data-kpi-text={k.searchText || `${k.name} ${k.step} ${k.baseline} ${k.target} ${k.source}`.toLowerCase()}>
                {kpiHeaders.map((h, idx) => {
                  const cls = kpiCellClass(h, idx);
                  const val = cells[idx] ?? '';
                  return (
                    <td
                      class={cls || undefined}
                      style={cls === 'status-col' && h.toLowerCase().includes('allikas') ? 'white-space:normal;' : undefined}
                      set:html={idx === 0 ? val.replace(/\*\*/g, '') : renderInline(val || '—')}
                    />
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Any extra ## sections added in Obsidian Veeb/Pikk vaade 2035 — seiretöölaud.md -->
  {extraSections.length > 0 && (
    <>
      <hr class="rule" />
      <section class="tufte-grid">
        <div class="tufte-main prose">
          {extraSections.map((sec) => (
            <div id={sec.id} style="margin-bottom: 2.5rem;">
              <h2 style="margin-top: 0;">{sec.heading}</h2>
              <div set:html={renderMarkdown(sec.markdown)} />
            </div>
          ))}
        </div>
      </section>
    </>
  )}

  <script>
    // Actions filter
    let activeStep = 'all';
    let activeStatus = 'all';
    const actionRows = Array.from(document.querySelectorAll('#actions-table tbody tr'));

    function applyActionFilters() {
      actionRows.forEach((tr) => {
        const s = tr.getAttribute('data-step');
        const st = tr.getAttribute('data-status');
        const okStep = activeStep === 'all' || s === activeStep;
        const okStatus = activeStatus === 'all' || st === activeStatus;
        tr.classList.toggle('hidden', !(okStep && okStatus));
      });
    }

    document.querySelectorAll('#step-toggles .toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#step-toggles .toggle-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeStep = btn.getAttribute('data-step') || 'all';
        applyActionFilters();
      });
    });

    document.querySelectorAll('#status-toggles .toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#status-toggles .toggle-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeStatus = btn.getAttribute('data-status') || 'all';
        applyActionFilters();
      });
    });

    // KPI filter
    let kpiStep = 'all';
    const kpiSearch = document.getElementById('kpi-search') as HTMLInputElement | null;
    const kpiRows = Array.from(document.querySelectorAll('#kpi-table tbody tr'));

    function applyKpiFilters() {
      const q = (kpiSearch?.value || '').trim().toLowerCase();
      kpiRows.forEach((tr) => {
        const s = tr.getAttribute('data-kpi-step');
        const txt = tr.getAttribute('data-kpi-text') || '';
        const okStep = kpiStep === 'all' || s === kpiStep;
        const okQ = !q || txt.includes(q);
        tr.classList.toggle('hidden', !(okStep && okQ));
      });
    }

    kpiSearch?.addEventListener('input', applyKpiFilters);
    document.querySelectorAll('#kpi-step-toggles .toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#kpi-step-toggles .toggle-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        kpiStep = btn.getAttribute('data-kpi-step') || 'all';
        applyKpiFilters();
      });
    });
  </script>
</BaseLayout>
