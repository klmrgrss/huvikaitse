---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/knowledge.json';
import { renderMarkdown } from '../../lib/markdown';

export function getStaticPaths() {
  return data.topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const base = data.basePath || '/huvikaitse';
const contentHtml = renderMarkdown(topic.markdown);
---

<BaseLayout title={topic.title} description={topic.summary} activeNav="teemad">
  <div class="breadcrumb">
    <a href={`${base}/`}>Avaleht</a> <span>/</span>
    <a href={`${base}/teemad/`}>Teemad</a> <span>/</span>
    <span>{topic.title}</span>
  </div>

  <article class="tufte-grid">
    <div class="tufte-main">
      <h1>{topic.title}</h1>

      {topic.slug.includes('pikk-vaade-2035') && (
        <p style="font-family: var(--font-sans); font-size: 0.92rem; margin-bottom: 1.4rem;">
          <a href={`${base}/pikk-vaade-2035/`} class="action-link">Ava interaktiivne „Pikk vaade 2035“ seiretöölaud →</a>
        </p>
      )}

      <div class="prose" set:html={contentHtml} />
    </div>

    <!-- Tufte margin column: contextual metadata & related topics directly beside content -->
    <aside class="tufte-margin" aria-label="Teema metaandmed ja seosed">
      <div class="margin-block">
        <p class="margin-heading">Valdkond</p>
        <p style="margin: 0 0 0.35rem; color: var(--ink);">
          {topic.workgroupSlug && topic.workgroupSlug !== 'ulene-koik-3-tooruhma' ? (
            <a href={`${base}/teemad/?toogrupp=${topic.workgroupSlug}`}>{topic.workgroup}</a>
          ) : (
            topic.workgroup
          )}
        </p>
        {topic.updated && (
          <p style="margin: 0; font-family: var(--font-sans); font-size: 0.8rem; color: var(--ink-muted);">
            Uuendatud: <span class="mono-num">{topic.updated}</span>
          </p>
        )}
      </div>

      {topic.backlinks && topic.backlinks.length > 0 && (
        <div class="margin-block">
          <p class="margin-heading">Seotud teemad</p>
          <ul class="margin-links">
            {topic.backlinks.map((bl) => (
              <li>
                <a href={`${base}${bl.route}`}>{bl.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="margin-block">
        <p class="margin-heading">Navigatsioon</p>
        <ul class="margin-links" style="font-family: var(--font-sans); font-size: 0.84rem;">
          <li><a href={`${base}/teemad/`}>← Kõik teemad</a></li>
          <li><a href={`${base}/pikk-vaade-2035/`}>Pikk vaade 2035 töölaud →</a></li>
        </ul>
      </div>
    </aside>
  </article>
</BaseLayout>
