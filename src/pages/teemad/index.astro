---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/knowledge.json';
import { renderInline } from '../../lib/markdown';

const base = data.basePath || '/huvikaitse';
const site = data.site || {};
const wgOptions = [
  { slug: 'all', label: `Kõik valdkonnad (${data.topics.length})` },
  { slug: 'ulene-koik-3-tooruhma', label: 'Ülene (Pikk vaade 2035)' },
  ...data.workgroups.map((w) => {
    const cnt = data.topics.filter((t) => t.workgroupSlug === w.slug).length;
    return { slug: w.slug, label: `${w.title} (${cnt})` };
  }),
];
---

<BaseLayout title="Teemad ja seisukohad" activeNav="teemad">
  <div class="breadcrumb">
    <a href={`${base}/`}>Avaleht</a> <span>/</span> <span>Teemad</span>
  </div>

  <div class="tufte-grid">
    <div class="tufte-main">
      <h1>{site.topicsPageTitle || 'EEELi seisukohad'}</h1>
      <p class="lead" set:html={renderInline(site.topicsPageLead || '')} />

      <ul class="editorial-list" id="topics-list" style="margin-top: 1.5rem;">
        {data.topics.map((t) => (
          <li
            class="editorial-item topic-row"
            data-wg={t.workgroupSlug}
            data-search={`${t.title} ${t.workgroup} ${t.summary} ${t.keyPoints.join(' ')}`.toLowerCase()}
          >
            <div class="editorial-item-meta">
              <span class="small-caps">{t.workgroup}</span>
              <span class="mono-num">{t.updated || ''}</span>
            </div>
            <h2 class="editorial-item-title" style="font-style: normal; border: none; padding: 0;">
              <a href={`${base}${t.route}`}>{t.title}</a>
            </h2>
            <p class="editorial-item-summary">{t.summary}</p>
          </li>
        ))}
      </ul>
      <p id="no-results" class="hidden" style="color: var(--ink-muted); margin-top: 1.5rem;">
        Valitud filtrile vastavaid teemasid ei leitud.
      </p>
    </div>

    <!-- Right margin column: search and plain-text workgroup toggles -->
    <aside class="tufte-margin margin-first-mobile" aria-label="Filtreerimine">
      <div class="margin-block">
        <p class="margin-heading">Otsing</p>
        <input
          id="topic-search"
          type="search"
          class="tufte-input"
          placeholder="Filtreeri märksõna järgi…"
          aria-label="Otsi teemasid"
        />
      </div>

      <div class="margin-block">
        <p class="margin-heading">Valdkond</p>
        <div class="toggle-group-vertical" id="wg-toggles">
          {wgOptions.map((w, idx) => (
            <button class:list={['toggle-btn', { active: idx === 0 }]} data-wg={w.slug}>
              {w.label}
            </button>
          ))}
        </div>
      </div>

      <div class="margin-block">
        <p class="margin-heading">Seiretöölaud</p>
        <p style="margin: 0;">
          Kokkuleppe 7 sammu ja {data.counts.kpis} mõõdiku võrdlus on koondatud{' '}
          <a href={`${base}/pikk-vaade-2035/`}>„Pikk vaade 2035“ töölauale</a>.
        </p>
      </div>
    </aside>
  </div>

  <script>
    let activeWg = 'all';
    const searchInput = document.getElementById('topic-search') as HTMLInputElement | null;
    const rows = Array.from(document.querySelectorAll('#topics-list .topic-row'));
    const noRes = document.getElementById('no-results');

    const params = new URLSearchParams(window.location.search);
    const paramWg = params.get('toogrupp');
    if (paramWg) {
      const targetBtn = document.querySelector(`#wg-toggles .toggle-btn[data-wg="${paramWg}"]`);
      if (targetBtn) {
        document.querySelectorAll('#wg-toggles .toggle-btn').forEach((b) => b.classList.remove('active'));
        targetBtn.classList.add('active');
        activeWg = paramWg;
      }
    }

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const wg = row.getAttribute('data-wg') || '';
        const txt = row.getAttribute('data-search') || '';
        const okWg = activeWg === 'all' || wg === activeWg;
        const okQ = !q || txt.includes(q);
        const show = okWg && okQ;
        row.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      noRes?.classList.toggle('hidden', visible > 0);
    }

    document.querySelectorAll('#wg-toggles .toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#wg-toggles .toggle-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeWg = btn.getAttribute('data-wg') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);
    applyFilters();
  </script>
</BaseLayout>
