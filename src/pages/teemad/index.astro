---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/knowledge.json';

const base = data.basePath || '/huvikaitse';
const wgOptions = [
  { slug: 'all', label: 'Kõik valdkonnad' },
  { slug: 'ulene-koik-3-tooruhma', label: 'Ülene (Pikk vaade)' },
  ...data.workgroups.map((w) => ({ slug: w.slug, label: w.title })),
];
---

<BaseLayout title="Teemad ja seisukohad" activeNav="teemad">
  <div class="breadcrumb">
    <a href={`${base}/`}>Avaleht</a> <span>/</span> <span>Teemad</span>
  </div>

  <div class="section-head" style="margin-top:0;">
    <h1 style="margin:0; font-size:28px; color:#0f2942;">EEELi seisukohad</h1>
  </div>

  <div class="filter-bar">
    <input id="topic-search" type="search" class="search-input" placeholder="Otsi teemat või märksõna…" />
    <div class="chip-group" id="wg-chips">
      {wgOptions.map((w, idx) => (
        <button class:list={['chip', { active: idx === 0 }]} data-wg={w.slug}>{w.label}</button>
      ))}
    </div>
  </div>

  <div class="grid-2" id="topics-grid">
    {data.topics.map((t) => (
      <a
        href={`${base}${t.route}`}
        class:list={['card topic-card', { featured: t.slug.includes('pikk-vaade-2035') }]}
        data-wg={t.workgroupSlug}
        data-search={`${t.title} ${t.workgroup} ${t.summary} ${t.keyPoints.join(' ')}`.toLowerCase()}
      >
        <div class="badges">
          <span class="badge badge-brand">{t.workgroup}</span>
        </div>
        <h3>{t.title}</h3>
        <p>{t.summary}</p>
        <div style="display:flex; justify-content:space-between; font-size:12px; color:#64748b; margin-top:4px;">
          <span>Uuendatud: {t.updated || '—'}</span>
          <span>Loe seisukohta →</span>
        </div>
      </a>
    ))}
  </div>

  <script>
    let activeWg = 'all';
    const searchInput = document.getElementById('topic-search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll('#topics-grid .topic-card'));

    // Read initial ?toogrupp= query param if present
    const params = new URLSearchParams(window.location.search);
    const paramWg = params.get('toogrupp');
    if (paramWg) {
      const targetBtn = document.querySelector(`#wg-chips .chip[data-wg="${paramWg}"]`);
      if (targetBtn) {
        document.querySelectorAll('#wg-chips .chip').forEach((b) => b.classList.remove('active'));
        targetBtn.classList.add('active');
        activeWg = paramWg;
      }
    }

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      cards.forEach((c) => {
        const wg = c.getAttribute('data-wg') || '';
        const txt = c.getAttribute('data-search') || '';
        const okWg = activeWg === 'all' || wg === activeWg;
        const okQ = !q || txt.includes(q);
        c.classList.toggle('hidden', !(okWg && okQ));
      });
    }

    document.querySelectorAll('#wg-chips .chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#wg-chips .chip').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeWg = btn.getAttribute('data-wg') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);
    applyFilters();
  </script>
</BaseLayout>
