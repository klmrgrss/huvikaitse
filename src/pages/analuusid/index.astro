---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/knowledge.json';

const base = data.basePath || '/huvikaitse';
---

<BaseLayout title="Analüüsid ja ülevaated" activeNav="analuusid">
  <div class="breadcrumb">
    <a href={`${base}/`}>Avaleht</a> <span>/</span> <span>Analüüsid</span>
  </div>

  <div class="tufte-grid">
    <div class="tufte-main">
      <h1>Analüüsid ja ülevaated</h1>
      <p class="lead">Faktipõhised taustaanalüüsid ja rahvusvahelised võrdlused.</p>

      <ul class="editorial-list" style="margin-top: 1.5rem;">
        <li class="editorial-item">
          <div class="editorial-item-meta">
            <span class="small-caps">Seiretöölaud</span>
          </div>
          <h2 class="editorial-item-title" style="font-style: normal; border: none; padding: 0;">
            <a href={`${base}/pikk-vaade-2035/`}>Ehituse pikk vaade 2035 — avalik seiretöölaud</a>
          </h2>
          <p class="editorial-item-summary">
            7 suure sammu visuaalne võrdlus, filtreeritav 39 tegevuse ülevaade ja 24 aastate lõikes jälgitavat seiremõõdikut.
          </p>
        </li>

        {data.analyses.map((a) => (
          <li class="editorial-item">
            <div class="editorial-item-meta">
              <span class="small-caps">Analüüs</span>
              <span class="mono-num">{a.updated || ''}</span>
            </div>
            <h2 class="editorial-item-title" style="font-style: normal; border: none; padding: 0;">
              <a href={`${base}${a.route}`}>{a.title}</a>
            </h2>
            <p class="editorial-item-summary">{a.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
