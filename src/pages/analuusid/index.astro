---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/knowledge.json';

const base = data.basePath || '/huvikaitse';
---

<BaseLayout title="Analüüsid ja ülevaated" activeNav="analuusid">
  <div class="breadcrumb">
    <a href={`${base}/`}>Avaleht</a> <span>/</span> <span>Analüüsid</span>
  </div>

  <div class="section-head" style="margin-top:0;">
    <h1 style="margin:0; font-size:28px; color:#0f2942;">Analüüsid ja ülevaated</h1>
    <p class="section-sub">Faktipõhised taustaanalüüsid, auditid ja rahvusvahelised võrdlused</p>
  </div>

  <div class="grid-2">
    <a href={`${base}/pikk-vaade-2035/`} class="card topic-card featured">
      <div class="badges">
        <span class="badge badge-info">Interaktiivne töölaud</span>
        <span class="badge badge-brand">Pikk vaade 2035</span>
      </div>
      <h3>Ehituse pikk vaade 2035 — avalik seiretöölaud</h3>
      <p>7 suure sammu visuaalne võrdlus, filtreeritav 39 tegevuse täitmismaatriks ja 24 aastase seiremõõdiku register.</p>
    </a>

    {data.analyses.map((a) => (
      <a href={`${base}${a.route}`} class="card topic-card">
        <div class="badges">
          <span class="badge badge-brand">Analüüs</span>
          {a.updated && <span class="badge">{a.updated}</span>}
        </div>
        <h3>{a.title}</h3>
        <p>{a.summary}</p>
      </a>
    ))}
  </div>
</BaseLayout>
